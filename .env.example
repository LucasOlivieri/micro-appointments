# Core settings
APPOINTMENTS_API_URL=http://127.0.0.1:8000
AGENT_MEMORY_PATH=memory.sqlite3

# LLM Settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Telegram integration
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.example/integrations/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Discord integration
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=your_bot_token

# Google Calendar integration
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_OAUTH_CLIENT_SECRET=client_secret_xxxxx.json
GOOGLE_TOKEN_FILE=google_token.json

# Dashboard
DASHBOARD_SUPERUSER_KEY=12345

# Admin panel
ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_URL=your-secret-admin-url
